# ---------------------------------------------------------------------------
# Secrets — never commit these.
# ---------------------------------------------------------------------------
# The upload keystore is the one artefact that cannot be regenerated: losing
# it means the app can never be updated under the same Play listing.
*.jks
*.keystore
*.p12
*.pepk
android/key.properties
**/google-services.json
**/GoogleService-Info.plist
*service-account*.json
.env
.env.*
!.env.example
secrets.properties

# ---------------------------------------------------------------------------
# Flutter / Dart
# ---------------------------------------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
.metadata
pubspec.lock.bak

# Generated code is checked in so a fresh clone builds without codegen.
# (lib/data/database.g.dart is intentionally NOT ignored.)

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
android/.gradle/
android/.kotlin/
android/captures/
android/local.properties
android/.cxx/
android/app/debug/
android/app/profile/
android/app/release/
*.iml
*.jar.sha256

# ---------------------------------------------------------------------------
# IDE / editor
# ---------------------------------------------------------------------------
.idea/
.vscode/
!.vscode/launch.json
!.vscode/settings.json
*.swp
*~

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Build output / release artefacts
# ---------------------------------------------------------------------------
release/
*.apk
*.aab
*.aab.idsig
*.apks
coverage/

# Intermediate screenshot capture. Only the finished Play-ready images in
# store/graphics/screenshots/ are tracked; these two folders are the unedited
# device captures and the staging copies used to produce them.
store/graphics/screenshots/raw/
store/graphics/screenshots/src/
